<?xml version="1.0"?>
<!-- Differential-drive mobile robot: two driven wheels and two passive casters.
     ROS convention (REP 103/105): x forward, y left, z up; base_footprint lies on the ground
     directly below base_link. Units: metres, radians, kilograms. -->
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial.xacro"/>

  <!-- ===== parameters: change a number here and the whole robot follows ===== -->
  <xacro:property name="base_radius" value="0.15"/>
  <xacro:property name="base_length" value="0.05"/>
  <xacro:property name="base_mass" value="5.0"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_separation" value="0.32"/>
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <xacro:property name="caster_x" value="0.12"/>

  <material name="grey"><color rgba="0.6 0.6 0.62 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="blue"><color rgba="0.2 0.45 0.85 1"/></material>

  <!-- base_footprint: on the ground. base_link: at wheel-axle height. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_length}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_length}"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="${base_mass}" r="${base_radius}" h="${base_length}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- A passive caster: a sphere touching the ground, fixed to base_link. -->
  <xacro:macro name="caster" params="name x">
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${name}_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>
    <link name="caster_${name}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertial m="${caster_mass}" r="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sphere_inertial>
    </link>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="back" x="${-caster_x}"/>

  <!-- A driven wheel. The cylinder's axis must point along y, so the visual is rolled by pi/2;
       the JOINT frame keeps the base's orientation, and the wheel spins about its y axis. -->
  <xacro:macro name="wheel" params="side y_sign">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
  </xacro:macro>

  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <!-- A 2D laser scanner on top, slightly forward. -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.08 0 ${base_length/2 + 0.015}" rpy="0 0 0"/>
  </joint>
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.03"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.03"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="0.1" r="0.03" h="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Simulation: ros2_control hardware + the Gazebo plugin that runs the controller_manager (Chapter 4). -->
  <xacro:include filename="diffbot.ros2_control.xacro"/>

</robot>
