<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control: which joints the controllers may command (command interfaces) and read (state interfaces).
       In simulation the "hardware" is Gazebo, provided by gz_ros2_control/GazeboSimSystem. On the real robot
       (Chapter 11) only this <hardware> plugin changes; controllers and config stay the same. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- The Gazebo system plugin that hosts the controller_manager inside the simulation. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find diffbot_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
