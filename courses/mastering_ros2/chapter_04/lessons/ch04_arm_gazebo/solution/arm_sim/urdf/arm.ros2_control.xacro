<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One position-controlled joint: command its position, read back position and velocity. -->
  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:position_joint name="shoulder_pan_joint"/>
    <xacro:position_joint name="shoulder_pitch_joint"/>
    <xacro:position_joint name="elbow_roll_joint"/>
    <xacro:position_joint name="elbow_pitch_joint"/>
    <xacro:position_joint name="wrist_roll_joint"/>
    <xacro:position_joint name="wrist_pitch_joint"/>
    <xacro:position_joint name="gripper_roll_joint"/>
    <xacro:position_joint name="left_finger_joint"/>
    <xacro:position_joint name="right_finger_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
