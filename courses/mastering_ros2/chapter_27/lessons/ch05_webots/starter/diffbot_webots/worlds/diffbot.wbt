#VRML_SIM R2025a utf8
# The diffbot in Webots: the same dimensions as urdf/diffbot.urdf, written as Webots nodes.
#   * DEF DIFFBOT Robot with controller "<extern>": Webots does not start a controller program itself; your
#     webots_driver node connects to it (WEBOTS_CONTROLLER_URL, set by the launch file).
#   * Devices are found by name from C++: left_wheel_motor / right_wheel_motor (RotationalMotor),
#     left_wheel_sensor / right_wheel_sensor (PositionSensor = wheel encoder), laser (Lidar).
#   * A wall 2 m ahead and a box 1.2 m to the left give the laser something to see.
# Webots uses the ROS convention: x forward, y left, z up; lengths in metres.

WorldInfo {
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material2 "caster"
      coulombFriction [ 0 ]
    }
  ]
}
Viewpoint {
  orientation -0.25 0.2 0.95 1.9
  position 0.9 -2.6 1.8
}
DirectionalLight {
  direction 0.3 0.4 -1
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.35 0.35 0.38 roughness 1 metalness 0 }
      geometry DEF FLOOR_GEOMETRY Plane { size 20 20 }
    }
  ]
  name "floor"
  boundingObject USE FLOOR_GEOMETRY
  locked TRUE
}
DEF WALL Solid {
  translation 2.05 0 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.8 0.55 0.3 roughness 1 metalness 0 }
      geometry DEF WALL_GEOMETRY Box { size 0.1 2 0.5 }
    }
  ]
  name "wall"
  boundingObject USE WALL_GEOMETRY
  locked TRUE
}
DEF BOX Solid {
  translation 0 1.3 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.3 0.6 0.35 roughness 1 metalness 0 }
      geometry DEF BOX_GEOMETRY Box { size 0.4 0.2 0.5 }
    }
  ]
  name "box"
  boundingObject USE BOX_GEOMETRY
  locked TRUE
}
DEF DIFFBOT Robot {
  name "diffbot"
  controller "<extern>"
  children [
    Pose {
      translation 0 0 0.05
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.6 0.6 0.62 roughness 0.6 metalness 0 }
          geometry DEF BASE Cylinder { height 0.05 radius 0.15 }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.16 0.05 }
      device [
        RotationalMotor { name "left_wheel_motor" maxVelocity 40 maxTorque 20 }
        PositionSensor { name "left_wheel_sensor" }
      ]
      endPoint Solid {
        translation 0 0.16 0.05
        rotation 1 0 0 1.5708
        name "left_wheel"
        children [ DEF WHEEL Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 1 metalness 0 } geometry Cylinder { height 0.025 radius 0.05 } } ]
        boundingObject Cylinder { height 0.025 radius 0.05 }
        physics Physics { density -1 mass 0.5 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.16 0.05 }
      device [
        RotationalMotor { name "right_wheel_motor" maxVelocity 40 maxTorque 20 }
        PositionSensor { name "right_wheel_sensor" }
      ]
      endPoint Solid {
        translation 0 -0.16 0.05
        rotation 1 0 0 1.5708
        name "right_wheel"
        children [ USE WHEEL ]
        boundingObject Cylinder { height 0.025 radius 0.05 }
        physics Physics { density -1 mass 0.5 }
      }
    }
    Solid {
      translation 0.12 0 0.025
      name "caster_front"
      contactMaterial "caster"
      boundingObject Sphere { radius 0.025 }
      physics Physics { density -1 mass 0.1 }
    }
    Solid {
      translation -0.12 0 0.025
      name "caster_back"
      contactMaterial "caster"
      boundingObject Sphere { radius 0.025 }
      physics Physics { density -1 mass 0.1 }
    }
    Lidar {
      translation 0.08 0 0.12
      name "laser"
      horizontalResolution 360
      fieldOfView 6.283185
      numberOfLayers 1
      minRange 0.05
      maxRange 8
      noise 0
    }
  ]
  boundingObject Pose { translation 0 0 0.05 children [ USE BASE ] }
  physics Physics { density -1 mass 5 }
}
