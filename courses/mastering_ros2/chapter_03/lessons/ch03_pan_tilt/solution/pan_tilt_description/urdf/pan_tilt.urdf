<?xml version="1.0"?>
<!-- A two-axis pan-tilt unit, e.g. for a camera. Units: metres, radians, kilograms. -->
<robot name="pan_tilt">

  <material name="dark"><color rgba="0.25 0.25 0.28 1"/></material>
  <material name="blue"><color rgba="0.2 0.45 0.85 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>

  <!-- base_link: the root of the tree. A flat disc lying on the ground. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.02"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.00565833" ixy="0" ixz="0" iyy="0.00565833" iyz="0" izz="0.01125"/>
    </inertial>
  </link>

  <!-- pan_joint: rotates everything above it about the vertical (z) axis. -->
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="5" velocity="1.5"/>
  </joint>

  <link name="pan_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.30"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.30"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00309" ixy="0" ixz="0" iyy="0.00309" iyz="0" izz="0.00018"/>
    </inertial>
  </link>

  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="5" velocity="1.5"/>
  </joint>

  <link name="tilt_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.25 0.08 0.06"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.25 0.08 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.0016525" iyz="0" izz="0.0017225"/>
    </inertial>
  </link>

  <!-- camera_link: a frame with no geometry at the front face of the tilt head. -->
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.125 0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>

</robot>
