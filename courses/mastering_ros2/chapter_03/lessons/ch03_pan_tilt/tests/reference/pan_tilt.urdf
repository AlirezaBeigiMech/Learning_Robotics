<!-- A two-axis pan-tilt unit, e.g. for a camera. Units: metres, radians, kilograms. -->
<robot name="pan_tilt">
  <material name="dark">
    <color rgba="0.25 0.25 0.28 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.45 0.85 1"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.55 0.15 1"/>
  </material>
  <!-- base_link: the root of the tree. A flat disc lying on the ground. -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <cylinder length="0.02" radius="0.15"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <cylinder length="0.02" radius="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <mass value="1"/>
      <inertia ixx="0.00565833" ixy="0" ixz="0" iyy="0.00565833" iyz="0" izz="0.01125"/>
    </inertial>
  </link>
  <!-- pan_joint: rotates everything above it about the vertical (z) axis. -->
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" lower="-2.6" upper="2.6" velocity="1.5"/>
  </joint>
  <link name="pan_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <cylinder length="0.30" radius="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <cylinder length="0.30" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <mass value="0.4"/>
      <inertia ixx="0.00309" ixy="0" ixz="0" iyy="0.00309" iyz="0" izz="0.00018"/>
    </inertial>
  </link>
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.30"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" lower="-1.2" upper="1.2" velocity="1.5"/>
  </joint>
  <link name="tilt_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <geometry>
        <box size="0.25 0.08 0.06"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <geometry>
        <box size="0.25 0.08 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <mass value="0.3"/>
      <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.0016525" iyz="0" izz="0.0017225"/>
    </inertial>
  </link>
  <!-- camera_link: a frame with no geometry at the front face of the tilt head. -->
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.125 0 0.03"/>
  </joint>
  <link name="camera_link"/>
</robot>
