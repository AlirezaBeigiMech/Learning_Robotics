<?xml version="1.0"?>
<!-- Seven-DOF serial manipulator with a two-finger gripper. Every joint frame sits at the bottom of the
     link it moves; links extend along their local +z axis. Units: metres, radians, kilograms. -->
<robot name="seven_dof_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial.xacro"/>

  <!-- ===== parameters ===== -->
  <xacro:property name="effort" value="30"/>
  <xacro:property name="velocity" value="1.0"/>

  <material name="grey"><color rgba="0.6 0.6 0.62 1"/></material>
  <material name="blue"><color rgba="0.2 0.45 0.85 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>

  <!-- ===== segment macros ===== -->
  <!-- A revolute joint plus a cylindrical link standing on it. -->
  <xacro:macro name="cylinder_segment" params="name parent joint_z axis lower upper r h m color">
    <joint name="${name}_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 ${joint_z}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${r}" length="${h}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${r}" length="${h}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${m}" r="${r}" h="${h}">
        <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>
  </xacro:macro>

  <!-- TODO 1: box_segment — same idea as cylinder_segment, but the link is a box of size x by y by z
       (params: name parent joint_z axis lower upper x y z m color). Use the box_inertial macro. -->
  <xacro:macro name="box_segment" params="name parent joint_z axis lower upper x y z m color">
  </xacro:macro>

  <!-- ===== the arm ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="1.0" r="0.06" h="0.05">
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <xacro:cylinder_segment name="shoulder_pan" parent="base_link" joint_z="0.05" axis="0 0 1"
                          lower="-2.6" upper="2.6" r="0.04" h="0.08" m="0.5" color="blue"/>

  <!-- TODO 2: instantiate the remaining six segments with your macros (values from the lesson table):
         shoulder_pitch (box), elbow_roll (cylinder), elbow_pitch (box), wrist_roll (cylinder),
         wrist_pitch (box), gripper_roll (cylinder). Each one's parent is the previous segment's link. -->


  <!-- TODO 3: the gripper. Write a `finger` macro (params: side y_sign) producing a prismatic joint
       <side>_finger_joint from gripper_roll_link, origin (0, y_sign*0.01, 0.02), axis (0, y_sign, 0),
       limits 0 .. 0.03 m, effort 10, velocity 0.5, and an orange 0.01 x 0.01 x 0.08 box link
       <side>_finger_link (mass 0.02 kg). The right finger must <mimic> left_finger_joint.
       Then instantiate left (y_sign=1) and right (y_sign=-1). -->


  <!-- TODO 4: grasp_frame — a geometry-less link fixed to gripper_roll_link 0.10 m up its z axis,
       joint name grasp_frame_joint. -->

</robot>
